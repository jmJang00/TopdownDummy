bool Proxy::Send(FSessionId* sessionIds, size_t cnt, const MessageArgs* args)
{
	switch (args->protocol)
	{
	{% for message in messages %}
	{% if can_send(message.direction) %}
	case {{ packet_id_enum }}::{{ message.packet_enum }}:
	{
		return {{ message.name }}(sessionIds, cnt, (const {{ message.name }}Args*)args);
	}
	{% endif %}
	{% endfor %}
	default:
		return false;
	}
}

