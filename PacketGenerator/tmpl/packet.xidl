}

// 1000 - 상자 ================================================================================

[direction(server_to_client)]
[packet(S_NTF_CREATE_CHEST)]
message S_NtfCreateChest
{
    int serverTick;
    uint entityId;
    Vector2 target;
}

[direction(server_to_client)]
[packet(S_NTF_DESTROY_CHEST)]
message S_NtfDestroyChest
{
    int serverTick;
    uint entityId;    
}

[direction(client_to_server)]
[packet(C_OPEN_CHEST)]
message C_OpenChest
{
    int clientTick;
    uint chestId;
}

[direction(client_to_server)]
[packet(C_CLOSE_CHEST)]
message C_CloseChest
{
    int clientTick;
    uint chestId;
}

[direction(server_to_client)]
[packet(S_OPEN_CHEST)]
message S_OpenChest
{
    int serverTick;
    uint chestId;
    ushort resultCode;   
}

[direction(server_to_client)]
[packet(S_CLOSE_CHEST)]
message S_CloseChest
{
    int clientTick;
    uint chestId;
    ushort resultCode;   
}

[direction(server_to_client)]
[packet(S_NTF_CHEST_INFO)]
message S_NtfChestInfo
{
    int serverTick;
    uint chestId;
    array<ItemElem> itemLists;
}

[direction(client_to_server)]
[packet(C_REQ_INVENTORY_INFO)]
message C_ReqInventoryInfo
{
    int clientTick;
}

[direction(server_to_client)]
[packet(S_RES_INVENTORY_INFO)]
message S_ResInventoryInfo
{
    int serverTick;
    array<ItemElem> itemLists;
}

[direction(client_to_server)]
[packet(C_REQ_INVENTORY_TO_CHEST)]
message C_ReqInventoryToChest
{
    int clientTick;
    int lastUpdateTick;
    int lastInventoryUpdateTick;
    uint entityId;
    uint inventoryCursor;
    uint chestId;
}

[direction(server_to_client)]
[packet(S_RES_INVENTORY_TO_CHEST)]
message S_ResInventoryToChest
{
    int serverTick;
    ushort resultCode;
}

[direction(client_to_server)]
[packet(C_REQ_CHEST_TO_INVENTORY)]
message C_ReqChestToInventory
{
    int clientTick;
    int lastUpdateTick;
    int lastInventoryUpdateTick;
    uint entityId;
    uint chestId;
    uint chestCursor;
}

[direction(server_to_client)]
[packet(S_RES_CHEST_TO_INVENTORY)]
message S_ResChestToInventory
{
    int serverTick;
    ushort resultCode;
}


// 1100 - 이동 ================================================================================

[direction(client_to_server)]
[packet(C_MOVE_START)]
[nolog]
message C_MoveStart {
    int clientTick;
    Vector2 target;
}

[direction(server_to_client)]
[packet(S_MOVE_START)]
[nolog]
message S_MoveStart {
    int acceptTick;
    uint id;
    Vector2 target;
}

[direction(server_to_client)]
[packet(S_MOVE_STATE)]
[nolog]
message S_MoveState {
    int currentTick;
    uint id;
    Vector2 pos;
    Vector2 target;
}

[direction(server_to_client)]
[packet(S_TICK_SYNC)]
[nolog]
message S_TickSync {
    int serverTick;
}

[direction(client_to_server)]
[packet(C_ROTATE_START)]
[nolog]
message C_RotateStart {
    int clientTick;
    float targetAngle;
}

[direction(server_to_client)]
[packet(S_ROTATE_START)]
[nolog]
message S_RotateStart {
    int acceptTick;
    uint id;
    float targetAngle;
}

[direction(server_to_client)]
[packet(S_ROTATE_STATE)]
[nolog]
message S_RotateState {
    int acceptTick;
    uint id;
    float currentAngle;
    float targetAngle;
}


