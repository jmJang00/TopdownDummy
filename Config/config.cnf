dummy
{
    // 바인딩 IP
    bind_ip = "0.0.0.0"

    // 연결할 서버 IP
    server_ip = "127.0.0.1"

    // 연결할 서버 포트
    server_port = "6000"

    // IOCP 워커 스레드 생성 수
    worker_thread_num = 2

    // IOCP 워커 스레드 러닝 수
    concurrent_thread_num = 2

    // 인코딩 여부
    encoding = 0

    // 네이글 옵션
    nagle = 1

    // SO_SNDBUF 0 옵션 
    sendbuf_zero = 1
}

thread
{
    // 유저 수 (MAX: 5000)
    user_num = 1

    // 유저 인포 선택
    user_info_file = "UserInfo_11.cnf"

    // BT 파일 선택
    user_bt_file = "bt_normal.cnf"
}

