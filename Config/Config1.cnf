/*
	< DUMMY V1 Config >
	
	* 블록 내의 값만 수정해주세요 *
	* 아직 최대 유저수는 한 프로세스에 5천명 입니다.

	< UserInfo에 관하여 >
	* UserInfo_1 ~ _20 은 각각 5000개의 유저 정보가 있습니다.
	* 총 10만개의 정보는 AccountNo, 아이디, 닉네임, 세션키가 중복되지 않습니다.
	* 더미를 두개 킨다면 각각 _1, _2 이런식으로 조합하여 사용하면 됩니다.
*/

CLIENT
{
	/* 인코딩 여부 (사용1, 미사용 0) */
	useEncode = 1

	/* 연결 할 유저 수 (최대 5000명) */
	maxUser = 5000

	/* 연결할 서버 아이피 (큰따옴표 제거하면 안되요) */
	serverIP = "127.0.0.1"

	/* 연결할 서버 포트 */
	serverPort = 6000

	/* 네트워크 처리할 iocp워커스레드 러닝 수 */
	workerThreadRunCnt = 6

	/* 네트워크 처리할 iocp워커스레드 생성 수 */
	workerThreadCreateCnt = 6

	/* tcp 네이글 끄면 1, 키면 0 */
	useTCP_NODELAY = 1

	/* SO_SNDBUF의 len = 0 사용시 1, 미사용시 0 */
	useSO_SNDBUF = 1

	/* UserInfo 어떤것을 사용할 것인지 (_1 ~ _20) */
	useUserInfoFile = "UserInfo_1.cnf"
}

/*
	< DUMMY_OPT 주의사항 >
	* 위 CLIENT 블록의 maxUser보다 많으면 안됨
	* 정상 유저는 (maxUser - DUMMY_OPT의 총 합) 으로 잡힙니다

	< 신규 옵션 (duplicateLogin, onlyConnect, strangePacket, overSend) 에 대한 주의사항 >
	* 서버쪽에서 accountNo를 끊은 이유와 같이 기록하면 좋습니다. (항상 정해진 accountNo만 그 행동을 합니다)
	
	* accountNo는 맨 앞에서 부터 순서대로 받게 됩니다.
	(예시 = 현재 세팅)
	. 사용 유저인포 UserInfo_1.cnf (accountNo: 1 ~ 5000)
 	. duplicateLogin = accountNo 1, 3, 5, 7, 9
	. onlyConnect = accountNo 11 ~ 20
	. strangePacket = accountNo 21 ~ 30
	. overSend = accountNo 31 ~ 40
	. timeOut = accountNo 41 ~ 340
	** 만약 UserInfo_2.cnf를 사용하게 되면 현재 위의 예시에서 각 accountNo에 + 5000 하면됩니다.

*/
DUMMY_OPT
{
	/* 중복 로그인 (**항상 짝수여야 함, 얘는 재연결을 하지 않음 따라서 언젠가 같이 로그인 요청을 보냄) */
	duplicateLogin = 10

	/* 연결만 하는 유저 (10초후에도 안끊겨있으면 로그인함) */
	onlyConnect = 10

	/* 이상한 패킷 보냄 (64,64를 벗어나는 위치, 메시지 길이 조작) */
	strangePacket = 10
	
	/* 패킷을 쏟음 (로그인, 섹터등록 이후에 채팅 메시지 1000개를 쏟음) */
	overSend = 10

	/* 타임 아웃할 유저 (로그인 패킷 보낸 이후로 패킷 송신X) */
	timeOut = 300

}

/*
	< SLEEP_TICK >
	. 원활한 테스트를 위해 주기를 조정합니다.
	. 재연결 사용 시 더미 스스로 끊고 재연결을 해서 
	  서버쪽에서 Disconnect인지보다 Connect요청이 더 빨라 중복 로그인 인지를 못할 수도 있습니다.
	  => 루프 조절이 필요합니다.
	. 단위는 ms입니다.
	
	** 두 옵션 모두 0 / 0 일 경우 기존 더미처럼 쉬지 않습니다.
*/
SLEEP_TICK
{
	/* 연결 요청 주기입니다. 너무 크면 루프에 영향을 줍니다. */
	connectTick = 0
	
	/* 바로 Connect를 하지 않기 위해서 유저 인덱스 반환을 늦춥니다. 서버에서 삭제할 시간을 충분히 줘 중복 연결 감지를 막습니다. */
	disconnectTick = 100
	
	/* 메시지 간격입니다. 클수록 워커 스레드와 최대 러닝 스레드를 늘려도 됩니다. (다 자러가서) */
	messageTick = 10
}


